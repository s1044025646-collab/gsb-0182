{
  "name": "mini-fbp-ct",
  "version": "1.0.0",
  "description": "小规模二维平行束 CT 前向投影与滤波反投影（FBP）后端：API + CLI",
  "type": "module",
  "bin": {
    "fbpct": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --experimental-sqlite --test dist/test/fbp.test.js",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "tsx src/server.ts",
    "demo": "tsc -p tsconfig.json && node --experimental-sqlite dist/demo.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
